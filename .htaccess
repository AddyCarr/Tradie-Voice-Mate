# Tradie Voice Mate — pretty URLs for personalised call-forwarding guides.
# Internal rewrite only: the browser keeps the pretty URL, Apache just serves
# the underlying static file. The page's own JS reads the number back out of
# location.pathname, so nothing needs to be passed as a query string here.
#
# https://tradievoicemate.com.au/call-forwarding/optus/0412345678
#   -> serves optus-call-forwarding-dynamic.html
# https://tradievoicemate.com.au/call-forwarding/telstra/0412345678
#   -> serves telstra-call-forwarding-dynamic.html

RewriteEngine On
RewriteRule ^call-forwarding/optus/([^/]+)/?$ /optus-call-forwarding-dynamic.html [L]
RewriteRule ^call-forwarding/telstra/([^/]+)/?$ /telstra-call-forwarding-dynamic.html [L]
